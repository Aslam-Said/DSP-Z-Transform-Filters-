%% ================= Question 5 =================
b5 = [0.03 -0.02 0.01];
a5 = [1 -2.8 3.02 -1.468 0.27];
H5 = tf(b5, a5, 1)                              % (a) transfer function

figure; zplane(b5, a5); title('Q5: Pole-Zero Plot');   % (b)
poles5 = roots(a5)
disp(max(abs(poles5)))   % if < 1 -> stable, if >= 1 -> not stable

N = 60;
x = 5 * ones(1, N);                             % x[n] = 5u[n]

y1 = filter(b5, a5, x);                         % I. relaxed system

zi = filtic(b5, a5, [-0.2 0.3 0 0]);            % II. y[-1..-4]
y2 = filter(b5, a5, x, zi);

figure;
subplot(2,1,1); stem(0:N-1, y1); grid on; title('Relaxed (zero initial conditions)');
subplot(2,1,2); stem(0:N-1, y2); grid on; title('With initial conditions'); xlabel('n');

%% ================= Question 6 =================
x = ones(1, 10);

ya = filter([1 0.5 2], 1, x);        % (a)
yb = filter(1, [1 -0.8], x);         % (b)
yc = filter([0 1], [1 -0.8], x);     % (c)  x[n-1] on the right side

figure;
subplot(3,1,1); stem(ya); title('(a)'); grid on;
subplot(3,1,2); stem(yb); title('(b)'); grid on;
subplot(3,1,3); stem(yc); title('(c)'); grid on;

% Steady state of (a) = sum of coefficients = 1 + 0.5 + 2 = 3.5
% (c) is just (b) delayed by one sample (the extra x[n-1] = a delay).

% y[n] = x[n] - x[n-1]  (difference / edge detector)
x2 = [1 1 1 1 1 2 1 1 1 1 1];
yd = filter([1 -1], 1, x2)
figure; stem(yd); grid on; title('y[n] = x[n] - x[n-1]');
% Output is 0 where the input is constant, and shows +1 / -1 where it
% changes. It is a high-pass filter: it detects changes and removes DC.

% Moving average filter of order five
bm = ones(1, 5) / 5;
x3 = [1 1 1 1 1 1 1 2 1 1 1 1];
ym = filter(bm, 1, x3)
figure;
stem(x3, 'filled'); hold on; stem(ym); grid on;
legend('Input', 'Moving average output');
% The sudden spike is smoothed (reduced to 1.2 and spread over 5 samples).
% It is a low-pass filter: it removes sharp changes/noise.
