%% DSP Lab 2 - Simple Solution
clc; clear; close all;

%% 
z = [2 3 4 5];           % zeros
p = [0.1 0.3 0.5 0.7];   % poles

b = poly(z)              % (a) numerator coefficients
a = poly(p)              % (b) denominator coefficients
                         % (c) H(z) = b/a  -> use these b and a vectors
H1 = tf(b, a, 1)

sos = zp2sos(z, p, 1)    % (d) second order sections

figure; zplane(z', p');  % (e) z-plane
title('Q1: Pole-Zero Plot');

% (f) Stability: all poles (0.1,0.3,0.5,0.7) are inside the unit circle
% -> the system is STABLE (zeros outside the circle don't affect stability).
disp(all(abs(p) < 1))    % 1 = stable

%% ================= Question 2 =================
b2 = [1 -2 2 -1];                               % numerator (in z^-1)
a2 = conv(conv([1 -1], [1 -0.5]), [1 -0.2]);    % denominator (in z^-1)

H2 = tf(b2, a2, 1);
figure; pzmap(H2); grid on; title('Q2: Pole-Zero Map');
% Poles: 1, 0.5, 0.2.  The numerator = (1 - z^-1)(1 - z^-1 + z^-2),
% so the zero at z = 1 CANCELS the pole at z = 1.
% Remaining poles (0.5, 0.2) are inside the unit circle -> STABLE
% (the ROC includes the unit circle after the cancellation).

h = filter(b2, a2, [1 zeros(1,49)]);            % impulse response
figure; stem(0:49, h); grid on;
title('Q2: Impulse Response'); xlabel('n'); ylabel('h[n]');

figure; freqz(b2, a2, 512);                     % frequency response
title('Q2: Frequency Response');

